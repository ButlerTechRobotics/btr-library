<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BTR Library add-in for SOLIDWORKS 2026.
    Build in Visual Studio 2022 (with the ".NET desktop development" workload) on the PC
    where SOLIDWORKS is installed. If SOLIDWORKS lives somewhere else, change SwApiDir.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>BtrLibrary</RootNamespace>
    <AssemblyName>BtrLibrary</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.3.0</Version>
    <Product>BTR Library for SOLIDWORKS</Product>
    <Description>Browse, search and insert FRC COTS parts from a shared library folder.</Description>
    <SwApiDir>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.VisualBasic" />

    <!-- BTR theme: logo/brand strip, tab icons, Barlow fonts (SIL Open Font License). -->
    <EmbeddedResource Include="Assets\*.png;Assets\Fonts\*.ttf" LogicalName="%(Filename)%(Extension)" />

    <!-- The parts list ships next to the DLL; Sync downloads everything in it. -->
    <None Include="..\manifest\library.json" Link="library.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared 3D previews (⋯ › Export previews for sharing). Sync uses these when the built-in parts list is used. -->
    <None Include="..\manifest\previews\*.mesh" Link="previews\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
